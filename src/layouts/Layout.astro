---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string }
const {
  title = 'LOCA | Local Community Action Alliance',
  description = 'LOCA is a Somali civil society organization committed to humanitarian relief, community empowerment and inclusive, sustainable development.',
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const programs = [
  { label: 'Humanitarian Response & Protection', href: '/what-we-do/humanitarian' },
  { label: 'Climate-Resilient Livelihoods', href: '/what-we-do/climate' },
  { label: 'WASH, Health, Nutrition & Education', href: '/what-we-do/health' },
  { label: 'Governance & Institutional Strengthening', href: '/what-we-do/governance' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Local Community Action Alliance',
  alternateName: 'LOCA',
  url: 'https://www.localliance.org',
  logo: 'https://www.localliance.org/images/logo.jpeg',
  description,
  email: 'info@localliance.org',
  telephone: '+252615508438',
  address: { '@type': 'PostalAddress', addressLocality: 'Mogadishu', addressCountry: 'SO' },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A3B1E" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LOCA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-white text-gray-800 font-sans antialiased flex flex-col min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:bg-loca-dark focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
    >
      Skip to content
    </a>

    <!-- ================= HEADER ================= -->
    <header id="site-header" class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100">
      <div class="container mx-auto px-6">
        <div class="flex justify-between items-center h-[76px]">
          <a href="/" class="flex items-center shrink-0" aria-label="LOCA home">
            <img src="/images/logo.jpeg" alt="LOCA - Local Community Action Alliance" class="h-11 w-auto" width="220" height="110" />
          </a>

          <!-- Desktop nav -->
          <nav class="hidden lg:flex items-center gap-7 font-semibold text-[15px]" aria-label="Main navigation">
            <a href="/about" class:list={['nav-link transition-colors', isActive('/about') ? 'active text-loca-primary' : 'text-gray-600 hover:text-loca-primary']}>About Us</a>

            <div class="relative group">
              <a
                href="/what-we-do"
                class:list={['nav-link flex items-center gap-1 transition-colors', isActive('/what-we-do') ? 'active text-loca-primary' : 'text-gray-600 hover:text-loca-primary']}
                aria-haspopup="true"
              >
                What We Do
                <Icon name="chevron-down" class="w-4 h-4 mt-px" />
              </a>
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
                <div class="w-80 bg-white rounded-2xl shadow-xl border border-gray-100 py-3">
                  <a href="/what-we-do" class="block px-5 py-2.5 text-sm font-bold text-loca-primary hover:bg-loca-light/60">All Programs</a>
                  {programs.map((p) => (
                    <a href={p.href} class="block px-5 py-2.5 text-sm text-gray-600 hover:bg-loca-light/60 hover:text-loca-dark">{p.label}</a>
                  ))}
                </div>
              </div>
            </div>

            <a href="/where-we-work" class:list={['nav-link transition-colors', isActive('/where-we-work') ? 'active text-loca-primary' : 'text-gray-600 hover:text-loca-primary']}>Where We Work</a>
            <a href="/accountability" class:list={['nav-link transition-colors', isActive('/accountability') ? 'active text-loca-primary' : 'text-gray-600 hover:text-loca-primary']}>Accountability</a>
            <a href="/news" class:list={['nav-link transition-colors', isActive('/news') ? 'active text-loca-primary' : 'text-gray-600 hover:text-loca-primary']}>News</a>
            <a href="/resources" class:list={['nav-link transition-colors', isActive('/resources') ? 'active text-loca-primary' : 'text-gray-600 hover:text-loca-primary']}>Resources</a>
          </nav>

          <div class="hidden lg:block">
            <a href="/contact" class="bg-loca-dark text-white px-6 py-2.5 rounded-lg font-semibold text-sm hover:bg-loca-primary transition-colors">
              Partner With Us
            </a>
          </div>

          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-700 hover:text-loca-primary" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100">
        <nav class="px-6 py-4 font-semibold text-gray-700" aria-label="Mobile navigation">
          <a href="/about" class="block py-3 border-b border-gray-50">About Us</a>
          <details class="acc py-3 border-b border-gray-50">
            <summary class="flex items-center justify-between">
              What We Do
              <Icon name="chevron-down" class="acc-chevron w-4 h-4 text-gray-400" />
            </summary>
            <div class="pt-3 pb-1 pl-3 space-y-1 text-sm font-medium text-gray-600">
              <a href="/what-we-do" class="block py-1.5 text-loca-primary font-bold">All Programs</a>
              {programs.map((p) => <a href={p.href} class="block py-1.5">{p.label}</a>)}
            </div>
          </details>
          <a href="/where-we-work" class="block py-3 border-b border-gray-50">Where We Work</a>
          <a href="/accountability" class="block py-3 border-b border-gray-50">Accountability</a>
          <a href="/news" class="block py-3 border-b border-gray-50">News</a>
          <a href="/resources" class="block py-3 border-b border-gray-50">Resources</a>
          <a href="/contact" class="mt-4 block text-center bg-loca-dark text-white px-6 py-3.5 rounded-lg">Partner With Us</a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-grow">
      <slot />
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-loca-dark text-white">
      <div class="container mx-auto px-6 pt-16 pb-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <div class="inline-block bg-white rounded-lg p-2 mb-5">
            <img src="/images/logo.jpeg" alt="LOCA logo" class="h-10 w-auto" width="200" height="100" loading="lazy" />
          </div>
          <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
            Locally led action. Dignity-centered humanitarian response. Resilient and inclusive communities.
          </p>
        </div>
        <div>
          <h4 class="font-bold mb-4 text-sm uppercase tracking-[0.14em] text-loca-light">Organization</h4>
          <ul class="text-sm text-gray-400 space-y-3">
            <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
            <li><a href="/about#governance" class="hover:text-white transition-colors">Governance</a></li>
            <li><a href="/what-we-do" class="hover:text-white transition-colors">What We Do</a></li>
            <li><a href="/where-we-work" class="hover:text-white transition-colors">Where We Work</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-4 text-sm uppercase tracking-[0.14em] text-loca-light">Accountability</h4>
          <ul class="text-sm text-gray-400 space-y-3">
            <li><a href="/accountability" class="hover:text-white transition-colors">Accountability (AAP)</a></li>
            <li><a href="/accountability#feedback" class="hover:text-white transition-colors">Feedback Channels</a></li>
            <li><a href="/accountability#psea" class="hover:text-white transition-colors">Safeguarding &amp; PSEA</a></li>
            <li><a href="/contact" class="hover:text-white transition-colors">Report a Concern</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-4 text-sm uppercase tracking-[0.14em] text-loca-light">Contact</h4>
          <ul class="text-sm text-gray-400 space-y-3">
            <li>Mogadishu, Somalia</li>
            <li><a href="mailto:info@localliance.org" class="hover:text-white transition-colors">info@localliance.org</a></li>
            <li><a href="tel:+252615508438" class="hover:text-white transition-colors">+252 615 508 438</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="container mx-auto px-6 py-6 flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-gray-500">
          <p>&copy; 2026 Local Community Action Alliance (LOCA). All rights reserved.</p>
          <div class="flex gap-5">
            <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-white transition-colors">Terms of Use</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Back to top -->
    <button id="to-top" aria-label="Back to top" class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-loca-dark text-white shadow-lg hover:bg-loca-primary transition-colors flex items-center justify-center">
      <Icon name="arrow-up" class="w-5 h-5" />
    </button>

    <script is:inline>
      (function () {
        // Mobile menu (hardened: scroll lock, Esc close, auto close)
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        function setMobileMenu(open) {
          if (!btn || !menu) return;
          menu.classList.toggle('hidden', !open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          document.body.style.overflow = open ? 'hidden' : '';
        }
        if (btn && menu) {
          btn.addEventListener('click', function () {
            setMobileMenu(menu.classList.contains('hidden'));
          });
          menu.addEventListener('click', function (e) {
            if (e.target.closest('a')) setMobileMenu(false);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') setMobileMenu(false);
          });
          if (window.matchMedia) {
            var mq = window.matchMedia('(min-width: 1024px)');
            var onMq = function (e) { if (e.matches) setMobileMenu(false); };
            if (mq.addEventListener) mq.addEventListener('change', onMq); else mq.addListener(onMq);
          }
        }
        // Header shadow on scroll
        var header = document.getElementById('site-header');
        if (header) {
          var onScroll = function () { header.classList.toggle('is-scrolled', window.scrollY > 8); };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }
        // Scroll-reveal (IntersectionObserver - no libraries)
        var els = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );
          els.forEach(function (el) { io.observe(el); });
        } else {
          els.forEach(function (el) { el.classList.add('is-visible'); });
        }
        // Back to top
        var toTop = document.getElementById('to-top');
        if (toTop) {
          var onScroll2 = function () { toTop.classList.toggle('is-visible', window.scrollY > 600); };
          window.addEventListener('scroll', onScroll2, { passive: true });
          toTop.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      })();
    </script>
  </body>
</html>
