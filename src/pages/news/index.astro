---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="News & Stories | LOCA" description="News, impact stories and updates from LOCA's programs and communities.">
  <!-- Page hero -->
  <section class="bg-loca-sand border-b border-gray-200 py-20">
    <div class="container mx-auto px-6">
      <p class="text-loca-primary font-bold uppercase tracking-[0.18em] text-sm mb-3 reveal">News &amp; Stories</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-loca-dark mb-5 reveal">Updates from the field</h1>
      <p class="text-xl text-gray-600 max-w-3xl leading-relaxed reveal" style="--rd:100ms">
        News, impact stories and press releases from our programs and the communities we serve.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      {posts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post, i) => (
            <a
              href={`/news/${post.id}`}
              class="group reveal flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border border-gray-100"
              style={`--rd:${(i % 3) * 80}ms`}
            >
              {post.data.image && (
                <div class="h-48 overflow-hidden">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                    width="900"
                    height="600"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <p class="text-xs font-bold text-loca-primary mb-2 uppercase tracking-[0.12em]">
                  {post.data.tag} &middot; {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </p>
                <h2 class="font-display font-bold text-lg text-loca-dark mb-2 leading-snug group-hover:text-loca-primary transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-gray-600 text-sm line-clamp-3 flex-grow">{post.data.excerpt}</p>
                <span class="inline-flex items-center gap-2 text-loca-primary font-bold text-sm mt-5">
                  Read story <Icon name="arrow-right" class="w-4 h-4" />
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="bg-gray-50 rounded-2xl border border-gray-100 p-10 text-center text-gray-500">
          <p>News and stories will appear here soon. Add markdown files to src/content/news/ to publish them.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
