---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Contact Us | LOCA" description="Contact LOCA for partnership enquiries, institutional information, or to submit confidential feedback.">
  <!-- Page hero -->
  <section class="bg-loca-sand border-b border-gray-200 py-20">
    <div class="container mx-auto px-6">
      <p class="text-loca-primary font-bold uppercase tracking-[0.18em] text-sm mb-3 reveal">Contact</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-loca-dark mb-5 reveal">Get in touch</h1>
      <p class="text-xl text-gray-600 max-w-3xl leading-relaxed reveal" style="--rd:100ms">
        For partnership enquiries, institutional information, or to submit confidential feedback.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 grid lg:grid-cols-5 gap-14">
      <!-- Info -->
      <div class="lg:col-span-2 reveal">
        <h2 class="font-display text-2xl font-bold text-loca-dark mb-7">Contact information</h2>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-xl bg-loca-light text-loca-primary flex items-center justify-center shrink-0">
              <Icon name="map-pin" class="w-6 h-6" />
            </span>
            <div>
              <p class="font-bold text-loca-dark mb-1">Head Office</p>
              <p class="text-gray-600 text-sm">Mogadishu, Somalia</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-xl bg-loca-light text-loca-primary flex items-center justify-center shrink-0">
              <Icon name="envelope" class="w-6 h-6" />
            </span>
            <div>
              <p class="font-bold text-loca-dark mb-1">Email</p>
              <a href="mailto:info@localliance.org" class="text-gray-600 text-sm hover:text-loca-primary transition-colors">info@localliance.org</a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-xl bg-loca-light text-loca-primary flex items-center justify-center shrink-0">
              <Icon name="phone" class="w-6 h-6" />
            </span>
            <div>
              <p class="font-bold text-loca-dark mb-1">Phone &amp; Feedback Line</p>
              <a href="tel:+252615508438" class="text-gray-600 text-sm hover:text-loca-primary transition-colors">+252 615 508 438</a>
            </div>
          </li>
        </ul>

        <div class="bg-loca-light/60 rounded-2xl p-6 mt-10 border border-loca-light">
          <h3 class="font-bold text-loca-dark mb-2 text-sm">Confidential concerns</h3>
          <p class="text-sm text-gray-700 leading-relaxed">
            If your message concerns safeguarding, misconduct or a sensitive protection matter, choose
            "Confidential Feedback / Complaint" as the subject — it is handled confidentially, with protection
            against retaliation. You can also use any channel on our
            <a href="/accountability#feedback" class="text-loca-primary font-semibold underline">accountability page</a>.
          </p>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3 reveal" style="--rd:120ms">
        <form id="contact-form" class="bg-gray-50 border border-gray-200 rounded-3xl p-8 md:p-10 space-y-5">
          <!-- IMPORTANT: replace YOUR_ACCESS_KEY_HERE with your free key from https://web3forms.com -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" />

          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label for="cf-name" class="block text-sm font-semibold text-gray-700 mb-2">Full name</label>
              <input id="cf-name" type="text" name="name" required class="w-full border border-gray-300 rounded-xl px-4 py-3.5 text-gray-900 focus:outline-none focus:border-loca-primary transition-colors" placeholder="Your name" />
            </div>
            <div>
              <label for="cf-email" class="block text-sm font-semibold text-gray-700 mb-2">Email address</label>
              <input id="cf-email" type="email" name="email" required class="w-full border border-gray-300 rounded-xl px-4 py-3.5 text-gray-900 focus:outline-none focus:border-loca-primary transition-colors" placeholder="you@example.org" />
            </div>
          </div>
          <div>
            <label for="cf-subject" class="block text-sm font-semibold text-gray-700 mb-2">Subject</label>
            <select id="cf-subject" name="subject" class="w-full border border-gray-300 rounded-xl px-4 py-3.5 text-gray-900 bg-white focus:outline-none focus:border-loca-primary transition-colors">
              <option>Partnership Enquiry</option>
              <option>Confidential Feedback / Complaint</option>
              <option>Media Request</option>
              <option>General Question</option>
            </select>
          </div>
          <div>
            <label for="cf-message" class="block text-sm font-semibold text-gray-700 mb-2">Message</label>
            <textarea id="cf-message" name="message" rows="5" required class="w-full border border-gray-300 rounded-xl px-4 py-3.5 text-gray-900 focus:outline-none focus:border-loca-primary transition-colors" placeholder="How can we help?"></textarea>
          </div>
          <button type="submit" id="submit-btn" class="w-full bg-loca-dark text-white font-bold py-4 rounded-xl hover:bg-loca-primary transition-colors disabled:opacity-60">
            Send Message
          </button>
          <div id="form-status" class="hidden text-center text-sm font-semibold p-4 rounded-xl"></div>
          <p class="text-xs text-gray-400 text-center">
            Your message is delivered securely to our team. For anonymous reporting, use the channels on our
            <a href="/accountability#feedback" class="underline">accountability page</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('contact-form');
    var btn = document.getElementById('submit-btn');
    var status = document.getElementById('form-status');
    if (!form) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      btn.disabled = true;
      btn.innerText = 'Sending...';
      status.className = 'hidden';

      var object = Object.fromEntries(new FormData(form).entries());
      object.access_key = 'YOUR_ACCESS_KEY_HERE'; // free key: https://web3forms.com

      try {
        var response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(object),
        });
        var result = await response.json();
        if (result.success) {
          status.innerText = 'Message sent successfully. We will get back to you soon.';
          status.className = 'block text-center text-sm font-semibold p-4 rounded-xl bg-loca-light text-loca-dark border border-loca-primary/20';
          form.reset();
        } else {
          throw new Error('Failed');
        }
      } catch (error) {
        status.innerText = 'Failed to send the message. Please try again later, or email info@localliance.org.';
        status.className = 'block text-center text-sm font-semibold p-4 rounded-xl bg-red-50 text-red-700 border border-red-200';
      } finally {
        btn.disabled = false;
        btn.innerText = 'Send Message';
      }
    });
  });
</script>
