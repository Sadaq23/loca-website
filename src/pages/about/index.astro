---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const identity = [
  { k: 'Organization name', v: 'Local Community Action Alliance' },
  { k: 'Acronym', v: 'LOCA' },
  { k: 'Organization type', v: 'Local Somali civil society organization (CSO)' },
  { k: 'Geographic focus', v: 'Somalia, with priority to underserved and hard-to-reach communities' },
  { k: 'Core mandate', v: 'Humanitarian relief, recovery, resilience and inclusive development' },
  { k: 'Primary target groups', v: 'Displaced and host communities; women and girls; children; youth; persons with disabilities; older people; and marginalized groups' },
];

const pillars = [
  {
    label: 'Our Vision',
    accent: 'bg-loca-light/60 border-loca-primary',
    title: 'A just, resilient and inclusive Somalia.',
    text: 'Where all people live in dignity, enjoy equal opportunities and can shape their own safe and sustainable futures.',
  },
  {
    label: 'Our Mission',
    accent: 'bg-loca-light/60 border-loca-primary',
    title: 'To work alongside vulnerable and underserved communities.',
    text: 'Delivering principled humanitarian assistance, strengthening essential services, expanding inclusive livelihood opportunities and advancing locally led solutions that reduce vulnerability, protect rights and build resilience.',
  },
  {
    label: 'Strategic Purpose',
    accent: 'bg-loca-sand border-loca-gold',
    title: 'Bridging relief and development.',
    text: 'LOCA exists to bridge the gap between immediate humanitarian needs and sustainable development — supporting communities to meet urgent needs, recover from shocks and participate meaningfully in decisions that affect their lives.',
  },
];

const values = [
  { icon: 'heart', title: 'Human dignity', text: 'We respect the worth, rights, choices and agency of every person.' },
  { icon: 'scale', title: 'Impartiality and need', text: 'We prioritize assistance according to assessed need, without discrimination or favoritism.' },
  { icon: 'users', title: 'Inclusion and equity', text: 'We identify and address barriers affecting women, children, youth, persons with disabilities and marginalized communities.' },
  { icon: 'eye', title: 'Accountability and transparency', text: 'We communicate openly, use resources responsibly and provide safe channels for feedback and complaints.' },
  { icon: 'shield-check', title: 'Integrity', text: 'We act honestly, prevent corruption and conflicts of interest, and uphold zero tolerance for exploitation, abuse and harassment.' },
  { icon: 'sparkles', title: 'Community leadership', text: 'We listen to communities and support their participation, ownership and leadership throughout the program cycle.' },
  { icon: 'users', title: 'Partnership and solidarity', text: 'We collaborate respectfully with communities, public institutions and other actors, recognizing complementary strengths.' },
  { icon: 'book-open', title: 'Learning and adaptability', text: 'We use evidence, reflection and innovation to improve quality, relevance and impact.' },
  { icon: 'heart', title: 'Environmental responsibility', text: 'We promote climate-sensitive, resource-efficient and environmentally responsible programming.' },
];

const how = [
  { title: 'Community-led program cycle', text: 'Engage communities in needs assessment, design, targeting, implementation, monitoring and learning.' },
  { title: 'Evidence-informed programming', text: 'Use context analysis, disaggregated data, participatory assessments and monitoring to guide decisions.' },
  { title: 'Integrated humanitarian-development approach', text: 'Connect emergency assistance with recovery, resilience, service strengthening and longer-term development.' },
  { title: 'Partnership-based delivery', text: 'Work with government institutions, community organizations, technical service providers and humanitarian/development partners, with clear roles and mutual accountability.' },
  { title: 'Quality and value for money', text: 'Apply sound project management, technical standards, proportionate controls and responsible resource use.' },
  { title: 'Adaptive management', text: 'Review progress and risks regularly and adjust approaches when evidence or context changes.' },
];

const groups = [
  'Internally displaced persons (IDPs), returnees and vulnerable host communities',
  'Women and girls, including female-headed households and survivors requiring safe referral and support',
  'Children and adolescents, including those affected by displacement and protection risks',
  'Youth facing unemployment, exclusion or limited access to skills and livelihoods',
  'Persons with disabilities and people with specific access or communication requirements',
  'Marginalized, minority and underserved communities, including remote rural and pastoralist populations',
  'Older people and households facing multiple and intersecting vulnerabilities',
];

const structure = [
  { n: '1', title: 'Board of Directors', text: 'LOCA’s highest governing and oversight body — strategic direction, policy approval, performance and risk oversight.' },
  { n: '2', title: 'Executive Director', text: 'Leads day-to-day management, accountable to the Board — translates strategy into plans, ensures compliance and represents LOCA.' },
  { n: '3', title: 'Directors of Programs & Operations', text: 'Thematic and operational leadership: programs and MEAL on one side; finance, supply chain, HR, IT and security on the other.' },
  { n: '4', title: 'Independent Audit, Risk & Compliance', text: 'An independent officer reviewing compliance and risk — segregation of duties, zero tolerance for fraud, safeguarding and PSEA standards across all programs.' },
];
---

<Layout title="About Us | LOCA" description="Learn about LOCA — a Somali civil society organization working with crisis-affected and underserved communities across Somalia.">
  <!-- Page hero -->
  <section class="bg-loca-sand border-b border-gray-200 py-20">
    <div class="container mx-auto px-6">
      <p class="text-loca-primary font-bold uppercase tracking-[0.18em] text-sm mb-3 reveal">About Us</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-loca-dark mb-5 reveal">A locally rooted organization for lasting change</h1>
      <p class="text-xl text-gray-600 max-w-3xl leading-relaxed reveal" style="--rd:100ms">
        LOCA is a Somali civil society organization committed to humanitarian relief, community empowerment and
        inclusive, sustainable development.
      </p>
    </div>
  </section>

  <!-- Who we are -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="article-body reveal">
        <p class="text-lg leading-relaxed">
          LOCA works with crisis-affected and underserved communities, particularly people living in
          hard-to-reach, fragile and displacement-affected areas of Somalia. We seek to ensure that people facing
          the greatest barriers to safety, services and opportunity are not left behind.
        </p>
        <p>
          Our programming places affected communities at the center of assessment, planning, implementation and
          accountability, while working in partnership with government institutions, community structures, civil
          society actors, UN agencies, international NGOs and development partners.
        </p>
        <p>
          We combine timely, principled humanitarian assistance with longer-term approaches that strengthen
          resilience, restore essential services, expand livelihood opportunities and support locally owned
          solutions — recognizing the interconnected effects of conflict, displacement, climate shocks, poverty,
          weak service access and social exclusion.
        </p>
      </div>

      <!-- Identity table -->
      <h2 id="identity" class="font-display text-2xl md:text-3xl font-bold text-loca-dark mt-16 mb-6 reveal">Organizational identity</h2>
      <div class="grid md:grid-cols-2 gap-px bg-gray-200 border border-gray-200 rounded-2xl overflow-hidden reveal">
        {identity.map((row) => (
          <div class="bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-gray-400 mb-1.5">{row.k}</p>
            <p class="text-gray-800 font-medium text-sm leading-relaxed">{row.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vision / Mission / Purpose -->
  <section class="py-20 bg-loca-sand border-y border-gray-200">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-6">
        {pillars.map((p, i) => (
          <div class={`reveal border-l-4 rounded-r-2xl p-7 ${p.accent}`} style={`--rd:${i * 90}ms`}>
            <p class="text-loca-primary dark:text-loca-primary font-bold uppercase tracking-[0.16em] text-xs mb-3">{p.label}</p>
            <h3 class="font-display text-2xl font-bold text-loca-dark mb-3 leading-snug">{p.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section id="values" class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-2xl mb-12 reveal">
        <p class="text-loca-primary font-bold uppercase tracking-[0.18em] text-sm mb-3">Our Values</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-loca-dark mb-4">Values and operating principles</h2>
        <p class="text-gray-600 text-lg">Nine principles guide how we work with communities and partners every day.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {values.map((v, i) => (
          <div class="reveal bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md hover:border-loca-primary/40 transition-all" style={`--rd:${(i % 3) * 80}ms`}>
            <div class="w-11 h-11 rounded-xl bg-loca-light text-loca-primary flex items-center justify-center mb-4">
              <Icon name={v.icon} class="w-6 h-6" />
            </div>
            <h3 class="font-bold text-loca-dark mb-2">{v.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="py-20 bg-loca-sand border-y border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="mb-10 reveal">
        <p class="text-loca-primary font-bold uppercase tracking-[0.18em] text-sm mb-3">How We Work</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-loca-dark">Our working approach</h2>
      </div>
      <ol class="space-y-4">
        {how.map((h, i) => (
          <li class="reveal flex gap-5 bg-white rounded-2xl border border-gray-100 p-6">
            <span class="font-display text-2xl font-bold text-loca-primary/30 shrink-0 w-10">0{i + 1}</span>
            <div>
              <h3 class="font-bold text-loca-dark mb-1">{h.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{h.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="mb-10 reveal">
        <p class="text-loca-primary font-bold uppercase tracking-[0.18em] text-sm mb-3">Who We Work With</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-loca-dark mb-4">Communities at the center</h2>
        <p class="text-gray-600 text-lg">
          We prioritize people and communities experiencing heightened vulnerability, exclusion or barriers to
          essential services and opportunities.
        </p>
      </div>
      <ul class="grid sm:grid-cols-2 gap-4">
        {groups.map((g, i) => (
          <li class="reveal flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-100" style={`--rd:${(i % 2) * 60}ms`}>
            <Icon name="check" class="w-5 h-5 text-loca-primary shrink-0 mt-0.5" />
            <span class="text-sm text-gray-700 leading-relaxed">{g}</span>
          </li>
        ))}
      </ul>
      <p class="text-sm text-gray-500 mt-6 reveal">
        Assistance is based on assessed needs and transparent, participatory vulnerability criteria — with
        safeguards against discrimination, exploitation, political interference and elite capture.
      </p>
    </div>
  </section>

  <!-- Governance -->
  <section id="governance" class="py-20 bg-loca-dark text-white relative overflow-hidden">
    <div class="absolute -top-24 right-0 w-[40vw] h-[30vh] bg-loca-primary/25 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="container mx-auto px-6 relative z-10 max-w-5xl">
      <div class="mb-12 reveal">
        <p class="text-loca-gold font-bold uppercase tracking-[0.18em] text-sm mb-3">Governance</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-5">Accountable structure, clear oversight</h2>
        <p class="text-gray-300 leading-relaxed max-w-3xl">
          The Board of Directors is LOCA’s highest governing and oversight body. It provides strategic direction,
          approves policies and plans, oversees institutional performance and risk, and holds the Executive
          Director accountable. The Executive Director leads day-to-day organizational management and is
          accountable to the Board.
        </p>
      </div>
      <div class="space-y-4">
        {structure.map((s, i) => (
          <div class="reveal flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur" style={`--rd:${i * 80}ms`}>
            <span class="w-12 h-12 rounded-full bg-loca-primary/30 border border-loca-primary/40 flex items-center justify-center font-display font-bold text-lg shrink-0">{s.n}</span>
            <div>
              <h3 class="font-bold text-lg text-loca-light">{s.title}</h3>
              <p class="text-sm text-gray-400 leading-relaxed">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-8 reveal">
        The Board operates under an approved constitution, terms of reference, conflict-of-interest provisions and
        a documented meeting and decision-making process. Organizational chart and leadership profiles will be
        published on this page.
      </p>
    </div>
  </section>
</Layout>
