---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Use | LOCA" description="Terms of use for the LOCA website.">
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-3xl article-body reveal">
      <h1 class="font-display text-4xl font-bold text-loca-dark mb-8">Terms of Use</h1>
      <p class="text-lg">
        This website is operated by the Local Community Action Alliance (LOCA). By using it, you accept these terms.
      </p>
      <h2>Use of content</h2>
      <p>
        Content on this site is provided for information about LOCA and its work. Text and materials may be shared
        with attribution for non-commercial purposes; photographs and other media may have additional usage
        restrictions. Please contact us for permission to republish.
      </p>
      <h2>Accuracy and links</h2>
      <p>
        We work to keep information current, but details may change without notice. Links to external websites are
        provided for convenience and do not imply endorsement; LOCA is not responsible for their content.
      </p>
      <h2>Contact</h2>
      <p>
        Questions about these terms can be sent to info@localliance.org.
      </p>
    </div>
  </section>
</Layout>
